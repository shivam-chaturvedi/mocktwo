# mocktwo Environment Configuration
# Copy this file to .env to customize local configuration

# Application Identity & Versioning
APP_NAME="mocktwo"
APP_VERSION="1.0.0"
APP_BUILD="1.0.0"
APP_ID="com.mocktwo.app"
APP_DESCRIPTION="Desktop rehearsal and conversational composure training application"
APP_AUTHOR="mocktwo"
APP_COPYRIGHT="Copyright © 2026 mocktwo"

# Vite Renderer Environment Variables (prefixed with VITE_)
VITE_APP_NAME="mocktwo"
VITE_APP_VERSION="1.0.0"

# Tavus Integration (Main process only - DO NOT prefix with VITE_)
TAVUS_API_KEY=
TAVUS_API_BASE_URL=https://tavusapi.com

