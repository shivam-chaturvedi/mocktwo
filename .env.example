# mocktwo Environment Configuration
# Copy this file to .env to customize local configuration

# Application Identity & Versioning
APP_NAME="mocktwo"
APP_VERSION="1.0.0"
APP_BUILD="1.0.0"
APP_ID="com.mocktwo.app"
APP_DESCRIPTION="Desktop rehearsal and conversational composure training application"
APP_AUTHOR="mocktwo"
APP_COPYRIGHT="Copyright © 2026 mocktwo"

# Vite Renderer Environment Variables (prefixed with VITE_)
VITE_APP_NAME="mocktwo"
VITE_APP_VERSION="1.0.0"

# Tavus Integration (Main process only - DO NOT prefix with VITE_)
TAVUS_API_KEY=
TAVUS_API_BASE_URL=https://tavusapi.com

# Seeding & Worker Pool Configuration
SEED_ENABLED=true
SEED_BATCH_SIZE=20
SEED_WORKER_MIN_THREADS=1
SEED_WORKER_MAX_THREADS=2
SEED_WORKER_IDLE_MS=10000
SEED_MAX_ATTEMPTS_PER_SESSION=5
SEED_BACKOFF_BASE_MS=1000
SEED_BACKOFF_MAX_MS=30000
SEED_FACE_POOL_MULTIPLIER=3
SEED_STARTUP_DELAY_MS=1000

# Tavus Catalog & Networking Configuration
TAVUS_FACES_PAGE_SIZE=20
TAVUS_FACES_MAX_PAGES=10
TAVUS_FACE_MODEL_NAME=phoenix-3
TAVUS_REQUEST_TIMEOUT_MS=15000
TAVUS_REQUEST_MAX_RETRIES=3
TAVUS_CATALOG_CACHE_TTL_MS=86400000

# UI List & Main Thread Performance Budgets
UI_LIST_PAGE_SIZE=20
MAIN_THREAD_LAG_BUDGET_MS=50

