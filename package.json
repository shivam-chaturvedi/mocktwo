{
  "name": "mocktwo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && electron .\"",
    "build": "tsc -b && vite build",
    "dist": "npm run build && electron-builder",
    "lint": "oxlint src",
    "preview": "vite preview",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.mocktwo.desktop",
    "productName": "mocktwo",
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "extendInfo": {
        "NSCameraUsageDescription": "mocktwo uses your camera to measure optical pulse, breathing and HRV vitals locally on your device.",
        "NSMicrophoneUsageDescription": "mocktwo uses your microphone for conversational rehearsal."
      }
    }
  },
  "dependencies": {
    "better-sqlite3": "^13.2.0",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.7",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "wait-on": "^9.5.1"
  }
}
