{
  "name": "mocktwo",
  "productName": "mocktwo",
  "description": "Desktop rehearsal and conversational composure training application",
  "author": "mocktwo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "clean": "rm -rf dist release",
    "dev": "node scripts/dev-runner.cjs",
    "build": "tsc -b && vite build",
    "dev:app": "npm run build && open node_modules/electron/dist/Electron.app --args $(pwd)",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac --arm64",
    "lint": "oxlint src",
    "test": "node --test src/services/*.test.ts tests/*.test.ts",
    "preview": "vite preview",
    "postinstall": "electron-builder install-app-deps && node scripts/brand-electron-dev.cjs"
  },
  "build": {
    "appId": "com.mocktwo.app",
    "productName": "mocktwo",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      ".env"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**",
      "**/node_modules/koffi/**"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "notarize": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "target": [
        "dmg",
        "zip"
      ],
      "extendInfo": {
        "NSCameraUsageDescription": "mocktwo uses your camera to measure optical blood volume pulse locally in real time using Presage SmartSpectra, and to stream video to interactive AI personas during live rehearsal calls. Physiological video is analyzed in local memory.",
        "NSMicrophoneUsageDescription": "mocktwo uses your microphone for real-time speech during live AI rehearsals and for local conversational speech pacing analysis."
      },
      "extraResources": [
        {
          "from": "node_modules/@smartspectra/node-sdk-darwin-${arch}/",
          "to": "smartspectra"
        },
        {
          "from": ".env",
          "to": ".env"
        }
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "extraResources": [
        {
          "from": "node_modules/@smartspectra/node-sdk-win32-${arch}/",
          "to": "smartspectra"
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "extraResources": [
        {
          "from": "node_modules/@smartspectra/node-sdk-linux-${arch}/",
          "to": "smartspectra"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "@daily-co/daily-js": "^0.95.0",
    "@smartspectra/node-sdk": "^3.5.0",
    "better-sqlite3": "^13.2.0",
    "dotenv": "^18.0.10",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.7",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "wait-on": "^9.5.1"
  }
}
